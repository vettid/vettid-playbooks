---
import Base from './Base.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import conceptsData from '../data/concepts.json';

interface Props {
  entry: CollectionEntry<'articles'>;
}
const { entry } = Astro.props;
const { data } = entry;

// The playbook bridge (spec §5.2.3): every playbook sharing a concern tag,
// derived from tags — never hand-wired.
const playbooks = await getCollection('playbooks');
const bridge = playbooks
  .map((p) => ({ p, overlap: p.data.concerns.filter((c) => data.concerns.includes(c)).length }))
  .filter((x) => x.overlap > 0)
  .sort((x, y) => y.overlap - x.overlap || x.p.data.time_minutes - y.p.data.time_minutes)
  .map((x) => x.p);

const platformPath = (p: (typeof playbooks)[number]) => `/playbooks/${p.data.platform}/${p.slug}`;

const articles = await getCollection('articles');

// The ideas form a reading path in concepts.json order. If this article is a
// concept's anchor (its primary concept, concepts[0]), link the neighboring
// anchors so the lexicon is walkable without returning to the landing page.
const anchors = conceptsData.concepts
  .map((c) => ({ term: c.term, a: articles.find((x) => x.data.concepts[0] === c.id) }))
  .filter((x) => x.a);
const here = anchors.findIndex((x) => x.a!.slug === entry.slug);
const prevIdea = here > 0 ? anchors[here - 1] : null;
const nextIdea = here >= 0 && here < anchors.length - 1 ? anchors[here + 1] : null;

// When no playbook shares a concern tag yet, offer sibling articles instead
// (same overlap mechanism as the bridge) so no page is a dead end.
const relatedArticles = bridge.length > 0 ? [] : articles
  .filter((a) => a.slug !== entry.slug)
  .map((a) => ({ a, overlap: a.data.concerns.filter((c) => data.concerns.includes(c)).length }))
  .filter((x) => x.overlap > 0)
  .sort((x, y) => y.overlap - x.overlap)
  .map((x) => x.a);
---
<Base title={`${data.title} — VettID Playbooks`} description={`${data.title} — a ${data.reading_minutes}-minute read from the VettID privacy playbooks.`}>
  <main class="article">
    <div class="head">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/playbooks/">Playbooks</a> <span class="sep">&rarr;</span> <a href="/playbooks/articles/">The ideas</a>
      </nav>
      <span class="eyebrow">{data.concepts.join(' · ')} &middot; {data.reading_minutes} min read</span>
      <h1>{data.title}</h1>
    </div>

    <slot />

    {bridge.length > 0 && (
      <aside class="bridge">
        <h2>Ready to fix this? &rarr;</h2>
        <div class="card-grid">
          {bridge.map((p) => (
            <a class="pb-card" href={platformPath(p)}>
              <h3>{p.data.title}</h3>
              <div class="meta">
                <span class="chip gold">{p.data.difficulty === 'warmup' ? 'Warm-up' : p.data.difficulty}</span>
                <span class="chip">~{p.data.time_minutes} min</span>
              </div>
            </a>
          ))}
        </div>
      </aside>
    )}

    {relatedArticles.length > 0 && (
      <aside class="bridge">
        <h2>Keep exploring</h2>
        <div class="card-grid">
          {relatedArticles.map((a) => (
            <a class="pb-card" href={`/playbooks/articles/${a.slug}`}>
              <h3>{a.data.title}</h3>
              <div class="meta"><span class="chip">{a.data.reading_minutes} min read</span></div>
            </a>
          ))}
        </div>
      </aside>
    )}

    {(prevIdea || nextIdea) && (
      <nav class="idea-nav" aria-label="More ideas">
        {prevIdea ? <a href={`/playbooks/articles/${prevIdea.a!.slug}`}>&larr; {prevIdea.term}</a> : <span></span>}
        {nextIdea ? <a href={`/playbooks/articles/${nextIdea.a!.slug}`}>{nextIdea.term} &rarr;</a> : <span></span>}
      </nav>
    )}

    {data.sources.length > 0 && (
      <div class="sources">
        <h2>Sources</h2>
        <ul>
          {data.sources.map((s) => (
            <li><a href={s.url} target="_blank" rel="noopener noreferrer">{s.title}</a> — {s.outlet}, {s.date.toLocaleDateString('en-US', { month: 'long', year: 'numeric' })}</li>
          ))}
        </ul>
      </div>
    )}
  </main>
</Base>

<style>
  .article { max-width: 720px; margin: 0 auto; padding: 130px 24px 40px; }
  .head { text-align: center; margin-bottom: 40px; }
  .head .eyebrow { display: block; margin-bottom: 16px; text-transform: capitalize; }
  h1 { font-size: clamp(1.9rem, 4.5vw, 2.6rem); font-weight: 800; letter-spacing: -0.02em; }

  .article :global(h2) { font-size: 1.4rem; margin: 44px 0 14px; }
  .article :global(p) { margin-bottom: 16px; }
  .article :global(ul) { padding-left: 22px; margin-bottom: 16px; }
  .article :global(li) { margin-bottom: 8px; }
  .article :global(blockquote) {
    border-left: 3px solid var(--gold);
    background: var(--surface-1);
    border-radius: 0 10px 10px 0;
    padding: 18px 22px;
    margin: 24px 0;
    color: var(--ink-hi);
  }

  .crumbs {
    font-family: var(--font-mono); font-size: 0.78rem; letter-spacing: 0.06em;
    color: var(--ink-mute); margin-bottom: 18px;
  }
  .crumbs a { color: var(--ink-mute); }
  .crumbs a:hover { color: var(--gold); text-decoration: none; }
  .crumbs .sep { color: #55556a; margin: 0 4px; }

  .bridge { margin-top: 56px; border-top: 1px solid var(--border-dark); padding-top: 36px; }
  .bridge h2 { text-align: center; margin-bottom: 22px; font-size: 1.5rem; }

  .idea-nav {
    display: flex; justify-content: space-between; gap: 16px;
    margin-top: 56px; padding-top: 22px;
    border-top: 1px solid var(--border-dark);
    font-weight: 600;
  }

  .sources { margin-top: 56px; border-top: 1px solid var(--border-dark); padding-top: 24px; }
  .sources h2 { font-size: 1rem; margin-bottom: 12px; color: var(--ink-mute); }
  .sources ul { padding-left: 20px; font-size: 0.9rem; }
  .sources li { margin-bottom: 6px; }
</style>
